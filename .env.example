# ==============================================================================
# MovieNex Recommendation System - Environment Configuration Template
# Copy this file to .env and fill in your confidential keys / overrides.
# ==============================================================================

# --- AI Assistant & Metadata APIs ---
TMDB_API_KEY="your-tmdb-api-key"
ZHIPUAI_API_KEY="your-zhipu-api-key"
ZHIPUAI_BASE_URL="https://api.z.ai/api/paas/v4/"
ZHIPUAI_MODEL="glm-4.7-flash"

# --- Relational Database (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_DB=movie_db
DB_HOST=127.0.0.1
DB_PORT=5435

# --- In-Memory Cache & Feature Store (Redis) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- Vector Database (Qdrant) ---
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333

# --- Object Storage & SeaweedFS (S3-compatible) ---
SEAWEEDFS_ACCESS_KEY=seaweedfskey
SEAWEEDFS_SECRET_KEY=seaweedfssecret
SEAWEEDFS_FILER_URL=http://127.0.0.1:8888
SEAWEEDFS_S3_ENDPOINT=http://127.0.0.1:8333

# --- MLflow Experiment Tracking ---
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# --- Model Serving & Verification ---
# Optional SHA256 checksum verification for model bundles downloaded from storage
RANKER_MODEL_SHA256=